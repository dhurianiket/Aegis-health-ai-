# Firebase client config (public by design; protect data with Security Rules + App Check)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Gemini — server-only secret (Express / Cloud Functions). Prefer this.
GEMINI_API_KEY=""
# TRANSITIONAL / RISKY: any VITE_* value is embedded in the JS bundle.
# Do not treat as secret. Migrate all Gemini calls to a server proxy; then remove this.
VITE_GEMINI_API_KEY=""

# Optional Cloudflare AI Gateway URL (public endpoint). Never put gateway auth tokens in VITE_*.
VITE_CLOUDFLARE_AI_GATEWAY_URL=""
# DO NOT SET client-side. If gateway auth is required, attach the token only on the server.
# VITE_CF_AIG_TOKEN is intentionally omitted.

VITE_RECAPTCHA_SITE_KEY="your_site_key_here"
VITE_FEEDBACK_FORM_ID=""
VITE_ADMIN_FEEDBACK_FORM_ID=""
VITE_VISIT_PREP_FORM_ID=""
GOOGLE_MAPS_PLATFORM_KEY=""

# GA4 measurement id is public-by-design; prefer env over hardcoding in source.
VITE_GA_MEASUREMENT_ID=""

# Server-only GA4 Measurement Protocol secret (Functions / Express). NEVER use a VITE_ prefix.
# GA_API_SECRET=""
