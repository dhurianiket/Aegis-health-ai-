# Firebase client config (public by design; protect data with Security Rules + App Check)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# --- Aegis Cloudflare edge Gemini proxy (aegishealthai-edge) ---
# Public Worker base (no trailing slash). Default used if unset: https://api.aegishealthai.co.in
VITE_EDGE_API_URL="https://api.aegishealthai.co.in"
# INTERIM: shared bearer (Worker secret EDGE_SHARED_SECRET). Embedded in the SPA bundle — leakable.
# Prefer Firebase ID-token auth on the Worker next; then remove this and rotate the secret.
VITE_AEGIS_EDGE_BEARER=""

# Server-only Gemini key for Express / Functions / Worker — NEVER VITE_ prefix in the SPA.
GEMINI_API_KEY=""

# Public bot protection and form config
VITE_RECAPTCHA_SITE_KEY="your_site_key_here"
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAFA-TF6j3OO6uZY0"
VITE_FEEDBACK_FORM_ID=""
VITE_ADMIN_FEEDBACK_FORM_ID=""
VITE_VISIT_PREP_FORM_ID=""
GOOGLE_MAPS_PLATFORM_KEY=""

# GA4 measurement id is public-by-design; prefer env over hardcoding in source.
VITE_GA_MEASUREMENT_ID=""

# Server-only GA4 Measurement Protocol secret (Functions / Express). NEVER use a VITE_ prefix.
# GA_API_SECRET=""
