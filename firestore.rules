rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'dhurianiket@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User root document
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role != 'admin'));
      allow update: if isAdmin() || (isOwner(userId) && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == resource.data.role));
      allow delete: if isAdmin() || isOwner(userId);

      // Lab reports and uploaded documents
      match /documents/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User profile
      match /profile/{profileId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Medications
      match /medications/{medId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // AI-generated insights and cached reports
      match /insights/{insightId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Cached AI reports
      match /cachedReports/{reportId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Usage analytics
      match /usage/{usageId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Catch-all for any other subcollections under a user
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admin-only global stats
    match /analytics/globalStats {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }
    
    // Support collectionGroup("usage") queries for Admin Dashboard
    match /{path=**}/usage/{usageId} {
      allow read: if isAdmin();
    }
    
    // Support collectionGroup("documents") queries for Admin Dashboard
    match /{path=**}/documents/{docId} {
      allow read: if isAdmin();
    }
    
    // Legacy globalStats mapping just in case
    match /globalStats/{statId} {
      allow read, write: if isAdmin();
    }

  }
}
