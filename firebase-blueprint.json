{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and basic medical baseline",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "bloodType": { "type": "string" },
        "chronicConditions": { "type": "array", "items": { "type": "string" } },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName"]
    },
    "MedicalDocument": {
      "title": "Medical Document",
      "description": "Information about an uploaded report",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["lab_report", "prescription", "consultation_note", "discharge_summary", "imaging_report"] },
        "date": { "type": "string", "format": "date" },
        "hospitalName": { "type": "string" },
        "doctorName": { "type": "string" },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" },
        "isProcessed": { "type": "boolean" },
        "extractedData": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "LabResult": {
      "title": "Lab Result",
      "description": "Individual lab test values extracted from documents",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "docId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "markerName": { "type": "string" },
        "value": { "type": "number" },
        "unit": { "type": "string" },
        "referenceRange": { "type": "string" },
        "status": { "type": "string", "enum": ["normal", "abnormal", "critical"] }
      }
    },
    "Medication": {
      "title": "Medication",
      "description": "Current or past medications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "dosage": { "type": "string" },
        "frequency": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "discontinued"] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string" },
        "purpose": { "type": "string" }
      }
    },
    "specialistInsight": {
      "title": "Specialist Insight",
      "description": "AI-generated specialist analysis",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "specialty": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "content": { "type": "string" },
        "confidence": { "type": "number" },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "HealthScore": {
      "title": "Health Score",
      "description": "Calculated score for a specific date",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "overall": { "type": "number" },
        "systems": { "type": "object" }
      }
    },
    "Profile": {
      "title": "Profile",
      "description": "Sub-profiles for family members",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles"
    },
    "profiles": {
      "schema": "Profile",
      "description": "Sub-profiles management"
    },
    "documents": {
      "schema": "MedicalDocument",
      "description": "Uploaded documents metadata"
    },
    "labResults": {
      "schema": "LabResult",
      "description": "Extracted lab values"
    },
    "medications": {
      "schema": "Medication",
      "description": "User medications"
    },
    "insights": {
      "schema": "specialistInsight",
      "description": "AI analysis entries"
    },
    "scores": {
      "schema": "HealthScore",
      "description": "Historical health scores"
    }
  }
}
