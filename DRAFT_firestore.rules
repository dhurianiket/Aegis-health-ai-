rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- PROFILES ---
    function isValidProfile(data) {
      return data.userId == request.auth.uid 
        && data.name is string && data.name.size() <= 100
        && (!('bloodType' in data) || (data.bloodType is string && data.bloodType.size() <= 5))
        && (!('gender' in data) || (data.gender is string && data.gender.size() <= 20));
    }

    match /profiles/{profileId} {
      allow get: if isOwner(existing().userId) || isSharedView(profileId);
      allow list: if isOwner(resource.data.userId); // Strict query enforcement
      
      allow create: if isOwner(incoming().userId) && isValidProfile(incoming());
      
      allow update: if isOwner(existing().userId) 
        && isValidProfile(incoming())
        && incoming().userId == existing().userId; // Immutable owner
        
      allow delete: if isOwner(existing().userId);
    }

    // --- SHARES ---
    function isValidShare(data) {
      return data.userId == request.auth.uid
        && isValidId(data.profileId)
        && data.expiresAt is timestamp
        && data.active == true;
    }

    match /shares/{shareId} {
      // Anyone with the shareId can read if it's active and not expired
      allow get: if existing().active == true && request.time < existing().expiresAt;
      
      allow create: if isOwner(incoming().userId) && isValidShare(incoming());
      
      allow update: if (
        // System incrementing viewCount or owner toggling active
        (existing().active == true && incoming().diff(existing()).affectedKeys().hasOnly(['viewCount']))
        || (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['active']))
      );
    }

    // Helper to check if a profile is currently shared
    // Note: get() uses a credit, but this is for specific shared view access
    function isSharedView(profileId) {
      // This is a bit complex for rules because we don't have the shareId here.
      // Usually, the SharedProfile component fetches the SHARE first, then the profile.
      // So the rule for profile read must allow access if a valid share exists for it.
      // But rules don't support collection group queries inside a get().
      // Instead, we trust the share link's existence to allow reading the profile's non-PII fields.
      // Actually, standard pattern is to check if there's a share record pointing to this profile.
      // But we can't easily query "is there ANY share which maps to this profileId and is not expired".
      // SO: We will allow 'get' on profile IF the request carries a valid share token? 
      // Firestore doesn't support custom tokens.
      // REVISED: The SharedProfile page will use a specialized rule or we'll allow public 'get' if the user knows the profileId? NO.
      // BETTER: The rule for profile READ will check if the request provides the shareId in some way? 
      // Actually, we can just allow 'get' on profiles if the document ID is known? Still too open.
      
      // Let's use the pattern: the share document is the gateway. 
      // If a user can read the SHARE, they can probably read the profile?
      // No, let's just make it simple: 
      // Profiles are sensitive. Shares are for specific views.
      // We will allow 'get' on profile if the user is the owner OR 
      // if they provide a valid share reference? 
      // Firestore doesn't have "authenticated by share link" concept easily.
      
      // WORKAROUND: Allow 'get' on profile if the document is requested directly AND 
      // we check a 'allowGetByShare' flag? No.
      
      // REAL SOLUTION: The SharedProfile page will fetch the profile.
      // We'll allow 'get' on /profiles/{profileId} if it's a specific document access.
      // Wait, the SharedProfile component does: `getDoc(doc(db, 'profiles', data.profileId))`
      // I'll allow this IF the ID is known. It's security through obscurity but the IDs are UUIDs.
      // Actually, I can do better: allow read if exists(/databases/$(database)/documents/shares/$(request.query.shareId))?
      // No, request.query is not available in rules.
      
      // FOR NOW: Let's stick to isOwner for profile and a controlled 'get' for shares.
      // To allow the shared view, I'll allow public GET on profiles ONLY if the specific doc is targeted.
      // AND I'll check if it's really public.
      return false; // placeholder
    }
    
    // Final check for SharedProfile compatibility:
    // The SharedProfile component needs to read ONE profile document.
    // I will allow 'get' if the document satisfies a share condition.
    // Since I can't easily link them in rules without the shareId, 
    // I'll allow public 'get' but NO 'list'.
    // This is acceptable for UUID-based document IDs in a health app if PII is minimized.
    // BUT the instructions say: DO NOT USE blanket reads.
    
    // Correct approach: The shared profile fetched is done via the ID found in the share doc.
  }
}
