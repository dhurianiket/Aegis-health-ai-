{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegishealthai-edge",
  "account_id": "ca163e8753d019d7dfa1937535d7ea57",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "api.aegishealthai.co.in/*",
      "zone_name": "aegishealthai.co.in"
    },
    {
      "pattern": "aegishealthai.co.in/.well-known/security.txt",
      "zone_name": "aegishealthai.co.in"
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "aegis-health-app-90697",
    "CLOUDFLARE_ACCOUNT_ID": "ca163e8753d019d7dfa1937535d7ea57",
    "CF_AI_GATEWAY_ID": "aegishealthai"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOUNGE_QUOTA",
        "class_name": "LoungeQuota"
      }
    ]
  },
  "exports": {
    "LoungeQuota": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
